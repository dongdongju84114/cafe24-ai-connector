PORT=4173
HOST=127.0.0.1

# Replace this with the real HTTPS hostname that reaches this connector.
# Examples:
# - https://cafe24-ai-dev.opengallery.co.kr
# - https://your-static-ngrok-domain.ngrok.app
PUBLIC_BASE_URL=https://cafe24-ai-dev.opengallery.co.kr

# Recommended production mode: keep OAuth/refresh tokens in LUNA and fetch only
# a short-lived access token into this process memory.
CAFE24_TOKEN_SOURCE=luna
CAFE24_DEFAULT_MALL_ID=opengallery12
CAFE24_API_VERSION=2026-03-01
LUNA_CAFE24_TOKEN_URL=https://www.opengallery.co.kr/api/cafe24/connector-token/
LUNA_CAFE24_TOKEN_API_KEY=
LUNA_CAFE24_MANAGE_URL=https://www.opengallery.co.kr/luna/cafe24/
LUNA_CAFE24_TOKEN_CACHE_TTL_MS=600000
LUNA_CAFE24_TOKEN_TIMEOUT_MS=15000

# Keep the fixed application scopes if Cafe24 requires them for this app.
# Add/remove scopes here whenever the Developer Admin scope selection changes.
CAFE24_SCOPES=mall.read_application,mall.write_application,mall.read_category,mall.read_product,mall.read_collection,mall.read_supply,mall.read_personal,mall.read_order,mall.read_community,mall.read_customer,mall.read_notification,mall.read_store,mall.read_promotion,mall.read_design,mall.read_salesreport,mall.read_privacy,mall.read_shipping,mall.read_translation,mall.read_analytics

# Internal API protection. Use a long random value and keep it server-side.
INTERNAL_API_KEY=
INTERNAL_ALLOWED_ORIGINS=
INTERNAL_ALLOWED_IPS=
INTERNAL_RATE_LIMIT_MAX=120
INTERNAL_RATE_LIMIT_WINDOW_MS=60000
INTERNAL_EXPOSE_CAFE24_ERROR_BODY=false

# Legacy self-managed OAuth mode only: set CAFE24_TOKEN_SOURCE=store and fill
# these values. They are not required in the recommended LUNA mode.
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=

# 32+ random bytes recommended for legacy store mode. Example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CAFE24_TOKEN_ENCRYPTION_KEY=
CAFE24_OAUTH_STATE_SECRET=

CAFE24_TOKEN_STORE_PROVIDER=file
CAFE24_TOKEN_STORE_PATH=./data/tokens.enc.json
# Render Persistent Disk example:
# CAFE24_TOKEN_STORE_PROVIDER=sqlite
# CAFE24_TOKEN_STORE_PATH=/var/data/cafe24-token-store.sqlite3
# CAFE24_TOKEN_MIGRATION_SOURCE=supabase
CAFE24_ALLOWED_ADMIN_PATH_PREFIXES=/api/v2/admin/orders,/api/v2/admin/products,/api/v2/admin/categories,/api/v2/admin/coupons,/api/v2/admin/customersprivacy,/api/v2/admin/financials,/api/v2/admin/reports

# Required only in legacy store mode while using Supabase or migrating a record.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TOKEN_TABLE=cafe24_tokens

# Optional: use docker-compose.cloudflare.yml after creating a Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
